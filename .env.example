# Sportmonks
SPORTMONKS_API_TOKEN=YOUR_TOKEN_HERE
SPORTMONKS_LEAGUE_ID=8

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=premier_predictor
POSTGRES_USER=premier
POSTGRES_PASSWORD=premier

# ETL
# Model icin varsayilan gecmis pencere: 1 yil. Daha uzun araliklar 100 gunluk parcalarla cekilir.
ETL_LOOKBACK_DAYS=365
ETL_CHUNK_DAYS=100
